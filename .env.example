# .env.example
# Copy this file to .env and fill in values before running the app.

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- App ---
# Set to "development" or "production"
APP_ENV=development

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Groq AI ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
