# .env.example
# Copy this file to .env and configure your environment variables.

# --- Server Settings ---
HOST=127.0.0.1
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# --- Groq AI Configuration ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOOL_CALLS=8

# --- Agent Timezone ---
APP_TIMEZONE=UTC
